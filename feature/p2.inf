# Explicitly provision the Ebi bundle on install/update (and remove it on uninstall).
# The default product-wide tooling.osgi.bundle.default CU is not shipped in our
# minimal update site. Bind a more-specific CU to our own bundle so p2 reliably
# changes the configured Equinox bundle list without a user running -clean.
#
# This is feature-group advice. $version$ is the Tycho-resolved feature version,
# equal to the org.ryoo.knimeEbi bundle version (including its qualifier).
requires.0.namespace=org.eclipse.equinox.p2.iu
requires.0.name=configure.org.ryoo.knimeEbi
requires.0.range=[$version$,$version$]
requires.0.greedy=true

units.0.id=configure.org.ryoo.knimeEbi
units.0.version=$version$
units.0.provides.1.namespace=org.eclipse.equinox.p2.iu
units.0.provides.1.name=configure.org.ryoo.knimeEbi
units.0.provides.1.version=$version$
units.0.instructions.install=org.eclipse.equinox.p2.touchpoint.eclipse.installBundle(bundle:${artifact});
units.0.instructions.uninstall=org.eclipse.equinox.p2.touchpoint.eclipse.uninstallBundle(bundle:${artifact});
units.0.instructions.unconfigure=org.eclipse.equinox.p2.touchpoint.eclipse.setStartLevel(startLevel:-1);
# Normal lazy OSGi activation is sufficient for KNIME node registration.
units.0.instructions.configure=org.eclipse.equinox.p2.touchpoint.eclipse.setStartLevel(startLevel:4);

# Two host requirements make this CU more specific than the product-wide
# default CU, avoiding two configuration units installing the same bundle.
units.0.hostRequirements.1.namespace=osgi.bundle
units.0.hostRequirements.1.name=org.ryoo.knimeEbi
units.0.hostRequirements.1.range=[$version$,$version$]
units.0.hostRequirements.1.greedy=false
units.0.hostRequirements.2.namespace=org.eclipse.equinox.p2.eclipse.type
units.0.hostRequirements.2.name=bundle
units.0.hostRequirements.2.range=[1.0.0,2.0.0)
units.0.hostRequirements.2.greedy=false

units.0.requires.1.namespace=osgi.bundle
units.0.requires.1.name=org.ryoo.knimeEbi
units.0.requires.1.range=[$version$,$version$]
units.0.requires.1.greedy=false
