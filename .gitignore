# Source-only repository. Generated sources and p2 output are rebuilt by the single workflow.
# Keep metadata snapshots + provenance lock checked in for review/reproducibility.

# Native Ebi JNI binaries: fetched from upstream or immutable GitHub Releases
*.so
*.dll
*.dylib
*.exe
/extension/lib/native-artifacts.json

# Generated node factories, node settings, KNIME registration and full catalog
/extension/plugin.xml
/extension/src/org/ryoo/knimeEbi/node/Ebi*NodeFactory.java
/extension/src/org/ryoo/knimeEbi/node/Ebi*NodeSettings.java
/extension/src/org/ryoo/knimeEbi/scaffolder/commands.xml

